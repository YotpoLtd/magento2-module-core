{
    "name": "yotpo/module-yotpo-core",
    "description": "Yotpo Reviews core extension for Magento2",
    "version": "4.3.12",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "require": {
        "php": "^7.1|^8.0",
        "magento/framework": ">=102.0.0"
    },
    "replace": {
        "yotpo/module-review": "*",
        "yotpo/magento2-module-yotpo-reviews": "*"
    },
    "conflict": {
        "yotpo/module-yotpo": "<4.0"
    },
    "type": "magento2-module",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Yotpo\\Core\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
